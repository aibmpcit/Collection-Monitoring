# Paste these values into the Dokploy Application Environment settings.
# Replace every REPLACE_* value with the private values from your Dokploy services.
NODE_ENV=production
PORT=4000
SERVE_CLIENT=true
API_BODY_LIMIT=25mb
DATABASE_URL=mysql://REPLACE_DB_USER:REPLACE_URL_ENCODED_PASSWORD@REPLACE_INTERNAL_MYSQL_HOST:3306/collection_monitoring
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Set true for the first deployment that should remove members, loans, payments,
# remarks, and attachments while retaining users and branches. The migration is
# recorded and cannot run twice. Change this to false after the successful deploy.
RUN_DATA_RESET_MIGRATION=true
