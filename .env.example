PORT=4000
API_BODY_LIMIT=25mb
DATABASE_URL=mysql://root@127.0.0.1:3306/collection_monitoring
JWT_SECRET=replace-with-a-long-random-secret
# Business timezone for stored dates and "today" (Philippines). Change only if the business moves.
APP_TIME_OFFSET=+08:00
# Comma-separated sites allowed to call the API from another origin. Leave empty when the API
# serves the UI itself (production Docker); development allows any origin.
CORS_ORIGIN=
# Set to 1 when running behind one reverse proxy (Dokploy/Traefik, nginx).
TRUST_PROXY=
VITE_API_BASE_URL=http://localhost:4000/api
RUN_DATA_RESET_MIGRATION=false

# Testing phase: false lets every loan import bring in remark columns (duplicates skipped).
# Set true at go-live so remarks import only once per branch, on its first import by a super admin.
REMARK_IMPORT_ONCE=false
